        Typeset`keyframeList$$}, 
      "Body" :> $CellContext`spacetimeInteractivePanel[$CellContext`k$$], 
      "Specifications" :> {{{$CellContext`k$$, 
          Rational[1, 2], "kappa"}, {-1, 
          Rational[-1, 2], 0, 
          Rational[1, 2], 1}}}, "Options" :> {ControlType -> SetterBar}, 
      "DefaultOptions" :> {}],
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>({$CellContext`spacetimeInteractivePanel[
         Pattern[$CellContext`k, 
          Blank[]]] := 
       Module[{$CellContext`speedText = 
          Which[$CellContext`k < 0, 
            "1/Sqrt[kappa] is imaginary, so no real invariant speed \
appears.", $CellContext`k == 0, 
            "1/kappa is undefined at kappa = 0, matching the missing \
velocity-scale ruler.", True, 
            "1/Sqrt[kappa] is finite and real, giving a shared invariant \
speed."], $CellContext`congruenceText = 
          Which[$CellContext`k < 0, 
            "The metric is positive on every nonzero direction once kappa is \
negative.", $CellContext`k == 0, 
            "The spatial part disappears from the canonical invariant form.", 
            True, "Rescaling space by 1/Sqrt[kappa] yields \
diag(1,-1,-1,-1)."]}, 
         Framed[
          Column[{
            Style["Spacetime and velocity consequences", 
             $CellContext`cardTitleStyle[
              $CellContext`branchColor[$CellContext`k]]], 
            Grid[{{"Metric", 
               TraditionalForm[
                $CellContext`spacetimeMetricExpr[$CellContext`k]]}, {
              "Invariant speed squared", 
               Which[$CellContext`k == 0, "undefined at kappa = 0", True, 
                TraditionalForm[
                 $CellContext`invariantSpeedSquaredExpr[$CellContext`k]]]}, {
              "Interpretation", $CellContext`speedText}, {
              "Geometry", $CellContext`congruenceText}}, Alignment -> Left, 
             Dividers -> {None, {False, True, True, True, False}}, ItemStyle -> {
               Directive[FontFamily -> "Helvetica", FontSize -> 12, 
                $CellContext`colors["Text"]], 
               Directive[FontFamily -> "Helvetica", FontSize -> 12, 
                $CellContext`colors["Text"]]}, Spacings -> {1., 0.8}]}, 
           Spacings -> 0.7], 
          Background -> $CellContext`branchFill[$CellContext`k], FrameStyle -> 
          Directive[
            $CellContext`branchColor[$CellContext`k], 
            AbsoluteThickness[2]], RoundingRadius -> 10, 
          FrameMargins -> {{14, 14}, {12, 12}}, 
          ImageSize -> {500, Automatic}]], $CellContext`cardTitleStyle[
         Pattern[$CellContext`color, 
          Blank[]]] := 
       Directive[$CellContext`color, FontFamily -> "Helvetica", FontSize -> 
         18, Bold], $CellContext`branchColor[
         Pattern[$CellContext`k, 
          Blank[]]] := Which[$CellContext`k < 0, 
         $CellContext`colors["Euclidean"], $CellContext`k == 0, 
         $CellContext`colors["Galilean"], True, 
         $CellContext`colors["Lorentz"]], $CellContext`colors = <|
        "Background" -> 
         RGBColor[0.9686274509803922, 0.9568627450980393, 0.9333333333333333],
          "Card" -> RGBColor[1., 0.9921568627450981, 0.9764705882352941], 
         "Text" -> RGBColor[
          0.13333333333333333`, 0.1450980392156863, 0.16862745098039217`], 
         "Slate" -> RGBColor[
          0.4196078431372549, 0.4588235294117647, 0.5176470588235295], 
         "Lorentz" -> 
         RGBColor[0.1411764705882353, 0.3411764705882353, 0.6509803921568628],
          "Galilean" -> 
         RGBColor[
          0.1803921568627451, 0.49019607843137253`, 0.42745098039215684`], 
         "Euclidean" -> 
         RGBColor[
          0.7215686274509804, 0.41568627450980394`, 0.1803921568627451], 
         "SoftLorentz" -> 
         RGBColor[0.9098039215686274, 0.9411764705882353, 1.], "SoftGalilean" -> 
