Cell[TextData[{
 StyleBox["Answer. ",
  FontWeight->"Bold",
  FontColor->RGBColor[
   0.1803921568627451, 0.49019607843137253`, 0.42745098039215684`]],
 "The algebra can examine itself. The Killing form is the decisive self-test, \
and it becomes blind precisely when the boost sector degenerates."
}], "Text",ExpressionUUID->"39d86e91-7a06-4029-a5a2-38068a2e9376"],

Cell["Three verdicts", "Section",ExpressionUUID->"54db6bb4-8b5a-4bf6-9faf-a983ecdf167a"],

Cell[TextData[{
 StyleBox["Question. ",
  FontWeight->"Bold",
  FontColor->RGBColor[
   0.1411764705882353, 0.3411764705882353, 0.6509803921568628]],
 "What does the self-test say in each regime?"
}], "Text",ExpressionUUID->"d760958c-fcb6-4dc6-be46-263f92d3a4ea"],

Cell["\<\
The notebook keeps the paper's verdict structure intact. Negative kappa \
leaves no causal distinction between directions. Zero kappa preserves shape \
but loses the ruler and leaves absolute time as background structure. \
Positive kappa yields the only branch with finite real invariant speed, \
Lorentzian metric, and causal structure.\
\>", "Text",ExpressionUUID->"f9294b46-6b19-4731-ad9c-beac8490bec7"],

