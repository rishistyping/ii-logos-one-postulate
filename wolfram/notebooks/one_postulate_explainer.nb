Cell["Three branches, three verdicts", "Section",ExpressionUUID->"75c38e88-a091-43ec-a9bb-60d6c43b91cd"],

Cell["\<\
The notebook keeps the interpretation compact: Euclidean when kappa is \
negative, Galilean when the boost block vanishes, Lorentzian when kappa is \
positive and spacetime is congruent to the standard Lorentz metric.\
\>", "Text",ExpressionUUID->"1dd95cca-8643-4690-8940-6a1a85a102f1"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Regime\"\>", "\<\"Boost block\"\>", "\<\"Invariant speed\"\>", \
"\<\"Spacetime consequence\"\>"},
    {"\<\"kappa < 0\"\>", "\<\"4 kappa I3 is negative\"\>", "\<\"imaginary / \
no real invariant speed\"\>", "\<\"Euclidean branch; no nonzero null \
vectors\"\>"},
    {"\<\"kappa = 0\"\>", "\<\"0\"\>", "\<\"undefined\"\>", "\<\"absolute \
time survives; spacetime form degenerates\"\>"},
    {"\<\"kappa > 0\"\>", "\<\"4 kappa I3 is positive\"\>", \
"\<\"1/Sqrt[kappa] is finite and real\"\>", "\<\"Lorentzian branch; metric \
congruent to diag(1,-1,-1,-1)\"\>"}
