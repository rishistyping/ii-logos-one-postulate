Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`k$$ = Rational[1, 2], Typeset`show$$ = True,
     Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`k$$], 
       Rational[1, 2], "kappa"}, {-1, 
       Rational[-1, 2], 0, 
       Rational[1, 2], 1}, ControlType -> SetterBar}}, Typeset`size$$ = 
    Automatic, Typeset`update$$ = 0, Typeset`initDone$$, 
    Typeset`skipInitDone$$ = False, Typeset`keyframeActionsQ$$ = False, 
    Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`k$$ = Rational[1, 2]}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, 
      "Body" :> $CellContext`regimeGraphic[$CellContext`k$$], 
      "Specifications" :> {{{$CellContext`k$$, 
          Rational[1, 2], "kappa"}, {-1, 
          Rational[-1, 2], 0, 
          Rational[1, 2], 1}}}, "Options" :> {ControlType -> SetterBar}, 
      "DefaultOptions" :> {}],
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>({$CellContext`regimeGraphic[
         Pattern[$CellContext`k, 
          Blank[]]] := Framed[
         Grid[{{
            Style["Selected kappa", 
             $CellContext`cardTitleStyle[
              $CellContext`branchColor[$CellContext`k]]], 
            Style[
             TraditionalForm[$CellContext`k], FontFamily -> "Helvetica", 
             FontSize -> 18, 
             $CellContext`colors["Text"]]}, {
            Style["Branch", $CellContext`baseLabelStyle], 
            Style[
             $CellContext`branchName[$CellContext`k], FontFamily -> 
             "Helvetica", FontSize -> 15, Bold, 
             $CellContext`branchColor[$CellContext`k]]}, {
            Style["gamma(v)", $CellContext`baseLabelStyle], 
            Style[
             TraditionalForm[
              $CellContext`gammaExpr[$CellContext`k]], FontFamily -> 
             "Helvetica", FontSize -> 15, 
             $CellContext`colors["Text"]]}, {
            Style["Galilean limit", $CellContext`baseLabelStyle], 
            Style[
             TraditionalForm[{
               Limit[
                $CellContext`tPrimeExpr[$CellContext`kappa], \
$CellContext`kappa -> 0], 
               Limit[
                $CellContext`xPrimeExpr[$CellContext`kappa], \
$CellContext`kappa -> 0]}], FontFamily -> "Helvetica", FontSize -> 14, 
             $CellContext`colors["Text"]]}}, Alignment -> Left, 
          Spacings -> {1., 0.9}], 
         Background -> $CellContext`branchFill[$CellContext`k], FrameStyle -> 
         Directive[
           $CellContext`branchColor[$CellContext`k], 
           AbsoluteThickness[2]], RoundingRadius -> 10, 
         FrameMargins -> {{14, 14}, {10, 10}}, 
         ImageSize -> {430, Automatic}], $CellContext`cardTitleStyle[
         Pattern[$CellContext`color, 
          Blank[]]] := 
       Directive[$CellContext`color, FontFamily -> "Helvetica", FontSize -> 
         18, Bold], $CellContext`branchColor[
         Pattern[$CellContext`k, 
          Blank[]]] := Which[$CellContext`k < 0, 
         $CellContext`colors["Euclidean"], $CellContext`k == 0, 
         $CellContext`colors["Galilean"], True, 
         $CellContext`colors["Lorentz"]], $CellContext`colors = <|
        "Background" -> 
         RGBColor[0.9686274509803922, 0.9568627450980393, 0.9333333333333333],
          "Card" -> RGBColor[1., 0.9921568627450981, 0.9764705882352941], 
         "Text" -> RGBColor[
          0.13333333333333333`, 0.1450980392156863, 0.16862745098039217`], 
         "Slate" -> RGBColor[
          0.4196078431372549, 0.4588235294117647, 0.5176470588235295], 
         "Lorentz" -> 
         RGBColor[0.1411764705882353, 0.3411764705882353, 0.6509803921568628],
          "Galilean" -> 
         RGBColor[
          0.1803921568627451, 0.49019607843137253`, 0.42745098039215684`], 
         "Euclidean" -> 
         RGBColor[
          0.7215686274509804, 0.41568627450980394`, 0.1803921568627451], 
         "SoftLorentz" -> 
         RGBColor[0.9098039215686274, 0.9411764705882353, 1.], "SoftGalilean" -> 
         RGBColor[0.8941176470588236, 0.9529411764705882, 0.9372549019607843],
          "SoftEuclidean" -> 
         RGBColor[0.9725490196078431, 0.9254901960784314, 0.8666666666666667],
          "SoftSlate" -> 
         RGBColor[
          0.9294117647058824, 0.9411764705882353, 
           0.9568627450980393]|>, $CellContext`baseLabelStyle = Directive[
         RGBColor[
         0.13333333333333333`, 0.1450980392156863, 0.16862745098039217`], 
         FontFamily -> "Helvetica", FontSize -> 13], $CellContext`branchName[
         Pattern[$CellContext`k, 
          Blank[]]] := 
       Piecewise[{{"Euclidean branch", $CellContext`k < 0}, {
          "Galilean branch", $CellContext`k == 0}, {
          "Lorentzian branch", $CellContext`k > 0}}], $CellContext`gammaExpr[
         Pattern[$CellContext`k, 
          Blank[]]] := 
       1/Sqrt[1 - $CellContext`k $CellContext`v^2], $CellContext`tPrimeExpr[
         Pattern[$CellContext`k, 
          
          Blank[]]] := $CellContext`gammaExpr[$CellContext`k] ($CellContext`t - \
$CellContext`k $CellContext`v $CellContext`x), $CellContext`xPrimeExpr[
         Pattern[$CellContext`k, 
          
          Blank[]]] := $CellContext`gammaExpr[$CellContext`k] ($CellContext`x - \
$CellContext`v $CellContext`t), $CellContext`branchFill[
         Pattern[$CellContext`k, 
          Blank[]]] := Which[$CellContext`k < 0, 
         $CellContext`colors["SoftEuclidean"], $CellContext`k == 0, 
         $CellContext`colors["SoftGalilean"], True, 
         $CellContext`colors["SoftLorentz"]]}; Typeset`initDone$$ = True),
