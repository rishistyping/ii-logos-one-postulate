Cell[TextData[{
 StyleBox["Answer. ",
  FontWeight->"Bold",
  FontColor->RGBColor[
   0.1803921568627451, 0.49019607843137253`, 0.42745098039215684`]],
 "The postulate allows only a self-contained explanation: external \
measurement may calibrate a scale later, but it should not choose the \
underlying geometric branch."
}], "Text",ExpressionUUID->"cea34121-cfbc-41ef-9c06-d4d31f4b1b22"],

Cell["What the postulate determines", "Section",ExpressionUUID->"5a5e8ffa-aac3-43d4-9a2d-9bef1d35c901"],

Cell[TextData[{
 StyleBox["Question. ",
  FontWeight->"Bold",
  FontColor->RGBColor[
   0.1411764705882353, 0.3411764705882353, 0.6509803921568628]],
 "What changes when kappa changes sign or magnitude?"
}], "Text",ExpressionUUID->"4705b5ed-1f7e-44d7-88a8-67cd3c47484f"],

Cell["\<\
The transformation law already contains the full one-parameter family. The \
second equation shifts position by relative motion; the first mixes space \
into time with strength set by kappa. When kappa = 0, the mixing vanishes and \
Newtonian time returns. When kappa > 0, gamma diverges as |v| approaches \
1/Sqrt[kappa].\
\>", "Text",ExpressionUUID->"dd237a4d-7490-4b12-b1fe-35254223c1fa"],

