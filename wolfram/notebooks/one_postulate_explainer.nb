Cell["The kinematic bracket family", "Section",ExpressionUUID->"6f562701-572a-445a-a2c5-95af50b57795"],

Cell["\<\
The bracket table below matches the local Lean conventions: rotations close \
among themselves, rotations send boosts to boosts, and the boost commutator \
scales as -kappa times a rotation.\
\>", "Text",ExpressionUUID->"eb4622a5-e7ac-4cad-8289-329eba1257de"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Bracket\"\>", "\<\"Exact local formula\"\>"},
    {"\<\"[J_i, J_j]\"\>", "\<\"Sum_k epsilon_ijk J_k\"\>"},
    {"\<\"[J_i, K_j]\"\>", "\<\"Sum_k epsilon_ijk K_k\"\>"},
    {"\<\"[K_i, K_j]\"\>", "\<\"Sum_k (-(kappa) epsilon_ijk) J_k\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       RGBColor[0.9294117647058824, 0.9411764705882353, 0.9568627450980393], 
       GrayLevel[1], 
       GrayLevel[1], 
       GrayLevel[1]}},
   GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxItemStyle->{"Columns" -> {{
        Directive[FontFamily -> "Helvetica", FontSize -> 12, 
         RGBColor[
         0.13333333333333333`, 0.1450980392156863, 0.16862745098039217`]]}}, 
     "Rows" -> {{
        Directive[FontFamily -> "Helvetica", FontSize -> 12, 
         RGBColor[
         0.13333333333333333`, 0.1450980392156863, 0.16862745098039217`]]}}},
   GridBoxSpacings->{"Columns" -> {{1.}}, "Rows" -> {{0.9}}}],
  "Grid"]], "Output",ExpressionUUID->"9e48798b-dca3-4f27-8f66-79bb5bee38bf"],

