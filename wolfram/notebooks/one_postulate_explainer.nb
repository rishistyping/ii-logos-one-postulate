Cell[TextData[{
 StyleBox["Answer. ",
  FontWeight->"Bold",
  FontColor->RGBColor[
   0.1803921568627451, 0.49019607843137253`, 0.42745098039215684`]],
 "Only kappa > 0 produces a finite real invariant speed, a Lorentzian \
spacetime metric, and causal structure without importing background geometry \
by hand."
}], "Text",ExpressionUUID->"ed81e272-84a3-40ca-8346-b1b2b149c095"],

Cell["Structure and scale", "Section",ExpressionUUID->"fe34c9b2-8fcf-42ee-b947-5cd1258007c3"],

Cell[TextData[{
 StyleBox["Question. ",
  FontWeight->"Bold",
  FontColor->RGBColor[
   0.1411764705882353, 0.3411764705882353, 0.6509803921568628]],
 "What still has to be calibrated by experiment?"
}], "Text",ExpressionUUID->"58a8d7cb-31bf-4c45-b4b9-4406cabbfc66"],

Cell["\<\
The paper's final distinction is preserved here: once the algebra has \
selected the positive-kappa branch, experiment fixes the numerical value of \
the invariant speed rather than the existence of such a speed. In that sense, \
calibration is empirical but the structural verdict is not.\
\>", "Text",ExpressionUUID->"6bd68dec-8a7c-468b-9bd9-69e5e67c49de"],

